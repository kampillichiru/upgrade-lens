{
  "schemaVersion": 1,
  "description": "Behavior probes for phase 5. Each probe is one HTTP request, run against a fresh server of each branch, in list order. Order matters: the first POST creates order id 1. flowId names the flow from phase 4 (or 'infrastructure'). linkedRules are the findings this probe can confirm (a difference) or verify (no difference).",
  "probes": [
    { "id": "P-01-create-valid", "flowId": "POST /api/orders", "method": "POST", "path": "/api/orders",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"customerId\":\"probe-a\",\"amountCents\":1500,\"currency\":\"USD\"}",
      "linkedRules": ["R-JACKSON-PACKAGE", "R-STARTER-REMOVED", "R-JAVA-RUNTIME"] },
    { "id": "P-02-create-negative-amount", "flowId": "POST /api/orders", "method": "POST", "path": "/api/orders",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"customerId\":\"probe-b\",\"amountCents\":-5,\"currency\":\"USD\"}",
      "linkedRules": ["R-VALIDATION-CHANGE"] },
    { "id": "P-03-create-lowercase-currency", "flowId": "POST /api/orders", "method": "POST", "path": "/api/orders",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"customerId\":\"probe-c\",\"amountCents\":100,\"currency\":\"usd\"}",
      "linkedRules": ["R-VALIDATION-CHANGE"] },
    { "id": "P-04-create-blank-customer", "flowId": "POST /api/orders", "method": "POST", "path": "/api/orders",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"customerId\":\"  \",\"amountCents\":100,\"currency\":\"USD\"}",
      "linkedRules": ["R-VALIDATION-CHANGE"] },
    { "id": "P-05-create-malformed-json", "flowId": "POST /api/orders", "method": "POST", "path": "/api/orders",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"customerId\":\"probe-e\",\"amountCents\":",
      "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-06-create-unknown-field", "flowId": "POST /api/orders", "method": "POST", "path": "/api/orders",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"customerId\":\"probe-f\",\"amountCents\":100,\"currency\":\"USD\",\"extra\":true}",
      "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-07-list", "flowId": "GET /api/orders", "method": "GET", "path": "/api/orders",
      "headers": {}, "body": null, "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-08-get-by-id", "flowId": "GET /api/orders/{id}", "method": "GET", "path": "/api/orders/1",
      "headers": {}, "body": null, "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-09-get-unknown", "flowId": "GET /api/orders/{id}", "method": "GET", "path": "/api/orders/999999",
      "headers": {}, "body": null, "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-10-totals", "flowId": "GET /api/orders/totals", "method": "GET", "path": "/api/orders/totals",
      "headers": {}, "body": null, "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-11-report-csv", "flowId": "GET /api/orders/report.csv", "method": "GET", "path": "/api/orders/report.csv",
      "headers": {}, "body": null, "linkedRules": ["R-HTTP-MAPPING-CHANGE", "R-STARTER-REMOVED"] },
    { "id": "P-12-report-csv-json-accept", "flowId": "GET /api/orders/report.csv", "method": "GET", "path": "/api/orders/report.csv",
      "headers": { "Accept": "application/json" }, "body": null, "linkedRules": ["R-HTTP-MAPPING-CHANGE"] },
    { "id": "P-13-cancel-existing", "flowId": "POST /api/orders/{id}/cancel", "method": "POST", "path": "/api/orders/1/cancel",
      "headers": {}, "body": null, "linkedRules": ["R-JACKSON-PACKAGE"] },
    { "id": "P-14-cancel-unknown", "flowId": "POST /api/orders/{id}/cancel", "method": "POST", "path": "/api/orders/999999/cancel",
      "headers": {}, "body": null, "linkedRules": [] },
    { "id": "P-15-trailing-slash", "flowId": "infrastructure", "method": "GET", "path": "/api/orders/",
      "headers": {}, "body": null, "linkedRules": ["R-HTTP-MAPPING-CHANGE"] },
    { "id": "P-16-actuator-health", "flowId": "infrastructure", "method": "GET", "path": "/actuator/health",
      "headers": {}, "body": null, "linkedRules": ["R-ACTUATOR-EXPOSURE"] },
    { "id": "P-17-actuator-info-hidden", "flowId": "infrastructure", "method": "GET", "path": "/actuator/info",
      "headers": {}, "body": null, "linkedRules": ["R-ACTUATOR-EXPOSURE"] }
  ]
}
